{
  "$description": "Generated by dtg from the definition file — do not edit.",
  "$extensions": {
    "com.fifthrevision.dtg": {
      "modes": [
        "light",
        "dark"
      ],
      "colorSpace": "srgb",
      "writingIntoFigma": "Set the Figma document color profile to srgb first — it cannot be set through the plugin API, only by hand. Then write each $value's components as {r, g, b, a}, or its hex where an API takes only hex; both name the same color in that profile. Nothing here is converted on import, so a document in any other profile will render every one of these wrong.",
      "changelog": [
        {
          "date": "2026-08-21",
          "note": "fixture for the golden-output test"
        },
        {
          "date": "2026-08-21",
          "note": "wide-gamut anchors, so the @supports layer is covered"
        }
      ]
    }
  },
